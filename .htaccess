Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block internal files and folders
    RewriteRule ^includes(/|$) - [F,L]
    RewriteRule (^|/)\.(?!well-known) - [F,L]
    RewriteRule \.(sql|md|log|ini|bak)$ - [F,L]

    # SEO-friendly URLs
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^robots\.txt$ robots.php [L]

    # Monetag push service worker (an uploaded sw.js file takes priority)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^sw\.js$ sw.php [L]
    RewriteRule ^page/([0-9]+)/?$ index.php?page=$1 [L,QSA]
    RewriteRule ^search/?$ index.php [L,QSA]

    # /post-slug  ->  post.php?slug=post-slug
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([A-Za-z0-9-]+)/?$ post.php?slug=$1 [L,QSA]

    # Anything else that does not exist
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ 404.php [L]
</IfModule>
